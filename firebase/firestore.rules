rules_version = '2';

// Claude@Stanford Firestore rules (2026-27 schema).
//
// Collections
//   builds/{id}     public when status == 'published'
//   resources/{id}  public when status == 'published' (shown as "Library")
//   users/{uid}     private: submitter emails. Readable by the user and leads only.
//   leads/{email}   lead allowlist, doc ID = lowercase @stanford.edu email. Managed in the console.
//
// Deploy:  firebase deploy --only firestore:rules
// Test:    cd firebase && npm install && npm test   (needs Java for the emulator)
//
// Field limits mirror assets/js/taxonomy.js (LIMITS). Keep them in sync.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Identity ----------

    function signedIn() {
      return request.auth != null;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    function isStanford() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower().matches('.*@stanford[.]edu$');
    }

    function isLead() {
      return isStanford()
        && exists(/databases/$(database)/documents/leads/$(myEmail()));
    }

    function isOwner() {
      return isStanford() && resource.data.ownerUid == request.auth.uid;
    }

    // ---------- Validation ----------

    function str(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }

    function httpUrl(v) {
      return v is string && v.size() <= 500 && v.matches('^https?://[^\\s]+$');
    }

    function optUrl(v) {
      return v is string && (v.size() == 0 || httpUrl(v));
    }

    function optEmail(v) {
      return v is string && (v.size() == 0 || (v.size() <= 120 && v.matches('^[^\\s@]+@[^\\s@]+[.][^\\s@]+$')));
    }

    // A list with at most maxItems entries and maxTotal characters overall (joined).
    // Checking each item separately blows Firestore's 1,000-expression budget, so per-item
    // length is enforced in the form instead. The site escapes every value when rendering.
    function strList(v, maxItems, maxTotal) {
      return v is list && v.size() <= maxItems && v.join(',').size() <= maxTotal;
    }

    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Fields every new post gets, set by the site rather than the user.
    function newPostOk(d) {
      return d.ownerUid == request.auth.uid
        && d.year is string && d.year.matches('^20[0-9]{2}-[0-9]{2}$')
        && d.status == 'published'
        && d.featured == false
        && d.createdAt == request.time
        && d.updatedAt == request.time;
    }

    // Leads can only flip visibility/featured, and must sign the change.
    function leadModeration() {
      return isLead()
        && changed().hasOnly(['status', 'featured', 'moderatedBy', 'moderatedAt'])
        && request.resource.data.status in ['published', 'hidden']
        && request.resource.data.featured is bool
        && request.resource.data.moderatedBy == myEmail()
        && request.resource.data.moderatedAt == request.time;
    }

    function readablePost() {
      return resource.data.status == 'published'
        || (signedIn() && resource.data.ownerUid == request.auth.uid)
        || isLead();
    }

    // ---------- Builds ----------

    function buildKeys() {
      return ['title', 'link', 'desc', 'tools', 'otherTools', 'categories', 'howBuilt',
              'authorName', 'linkedin', 'contactEmail',
              'ownerUid', 'year', 'status', 'featured', 'hearts', 'createdAt', 'updatedAt'];
    }

    function buildEditableKeys() {
      return ['title', 'link', 'desc', 'tools', 'otherTools', 'categories', 'howBuilt',
              'authorName', 'linkedin', 'contactEmail', 'updatedAt'];
    }

    function buildContentOk(d) {
      return str(d.title, 1, 80)
        && httpUrl(d.link)
        && str(d.desc, 1, 600)
        && strList(d.tools, 10, 450)
        && strList(d.otherTools, 10, 900)
        && strList(d.categories, 6, 250)
        && str(d.howBuilt, 0, 6000)
        && str(d.authorName, 1, 80)
        && optUrl(d.linkedin)
        && optEmail(d.contactEmail);
    }

    // Add or remove exactly your own uid, on someone else's build, touching nothing else.
    function heartToggle() {
      let before = resource.data.get('hearts', []).toSet();
      let afterList = request.resource.data.hearts;
      let after = afterList.toSet();
      let me = [request.auth.uid].toSet();
      return isStanford()
        && resource.data.ownerUid != request.auth.uid
        && changed().hasOnly(['hearts'])
        && afterList is list
        && afterList.size() == after.size()
        && ((after.difference(before) == me && before.difference(after).size() == 0)
          || (before.difference(after) == me && after.difference(before).size() == 0));
    }

    match /builds/{id} {
      allow read: if readablePost();

      allow create: if isStanford()
        && request.resource.data.keys().hasAll(buildKeys())
        && request.resource.data.keys().hasOnly(buildKeys())
        && buildContentOk(request.resource.data)
        && newPostOk(request.resource.data)
        && request.resource.data.hearts is list
        && request.resource.data.hearts.size() == 0;

      allow update: if (isOwner()
          && changed().hasOnly(buildEditableKeys())
          && buildContentOk(request.resource.data)
          && request.resource.data.updatedAt == request.time)
        || heartToggle()
        || leadModeration();

      allow delete: if isOwner() || isLead();
    }

    // ---------- Resources (Library) ----------

    function resourceKeys() {
      return ['title', 'url', 'why', 'tools', 'categories', 'authorName',
              'ownerUid', 'year', 'status', 'featured', 'createdAt', 'updatedAt'];
    }

    function resourceEditableKeys() {
      return ['title', 'url', 'why', 'tools', 'categories', 'authorName', 'updatedAt'];
    }

    function resourceContentOk(d) {
      return str(d.title, 1, 80)
        && httpUrl(d.url)
        && str(d.why, 1, 1000)
        && strList(d.tools, 10, 450)
        && strList(d.categories, 6, 250)
        && str(d.authorName, 1, 80);
    }

    match /resources/{id} {
      allow read: if readablePost();

      allow create: if isStanford()
        && request.resource.data.keys().hasAll(resourceKeys())
        && request.resource.data.keys().hasOnly(resourceKeys())
        && resourceContentOk(request.resource.data)
        && newPostOk(request.resource.data);

      allow update: if (isOwner()
          && changed().hasOnly(resourceEditableKeys())
          && resourceContentOk(request.resource.data)
          && request.resource.data.updatedAt == request.time)
        || leadModeration();

      allow delete: if isOwner() || isLead();
    }

    // ---------- Users (private) ----------

    match /users/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isLead();
      allow create, update: if isStanford()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'name', 'updatedAt', 'createdAt'])
        && request.resource.data.email == myEmail()
        && str(request.resource.data.name, 0, 80)
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // ---------- Leads (console-managed allowlist) ----------

    match /leads/{leadEmail} {
      allow read: if (isStanford() && myEmail() == leadEmail) || isLead();
      allow write: if false;
    }

    // ---------- LEGACY: 2025-26 single-page site ----------
    // Keeps the old site working while the new one is previewed and migrated.
    // DELETE THIS WHOLE BLOCK and redeploy right after the new site goes live.
    // Removing it is what stops submitters' emails being publicly readable.
    match /projects/{id} {
      allow read: if true;
      allow create: if isStanford() && request.resource.data.submittedByUid == request.auth.uid;
      allow update: if isStanford()
        && (resource.data.submittedByUid == request.auth.uid
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hearts']));
      allow delete: if isStanford() && resource.data.submittedByUid == request.auth.uid;
    }
    match /library/{id} {
      allow read: if true;
      allow create: if isStanford() && request.resource.data.submittedByUid == request.auth.uid;
      allow update, delete: if isStanford() && resource.data.submittedByUid == request.auth.uid;
    }
    // ---------- END LEGACY ----------
  }
}
